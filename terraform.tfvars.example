aws_region = "ap-southeast-2"
# aws_profile = "your-sandbox-profile"

name          = "ami-ssm-asg-refresh"
instance_type = "t3.micro"

# Increment both values for each successful lab iteration.
recipe_version = "1.0.0"
release_id     = "v1"

# Set true only for the failed-image-test acceptance case, with a new recipe_version.
force_test_failure = false
